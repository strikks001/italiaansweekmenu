# Optioneel: echt maandelijks zoekvolume in scripts/zoekwoorden.mjs.
#
# DataForSEO werkt met vooruitbetaald tegoed dat niet verloopt: minimale storting
# $50, zoekvolume kost $0,0001 per zoekwoord. Voor een wekelijkse blog is dat
# in de praktijk een eenmalige storting die jaren meegaat.
#
# Aanmaken op https://app.dataforseo.com/api-access
# Zonder deze variabelen werkt het script gewoon, alleen zonder volumecijfers.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
